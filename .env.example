# ─────────────────────────────────────────
# Immich
# ─────────────────────────────────────────
IMMICH_VERSION=v3.3.6

# Public-facing URL (used for OAuth redirect URIs)
IMMICH_URL=https://photos.example.com

# Domain prefix used for extra_hosts (must match your Authentik subdomain)
DOMAIN=example.com

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
DB_HOSTNAME=postgres
DB_DATABASE_NAME=immich
DB_USERNAME=immich
DB_PASSWORD=

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_HOSTNAME=redis
